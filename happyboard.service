[Unit]
Description=HappyBoard - cross-platform hotkey controller
Documentation=https://github.com/happyboard/happyboard
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/happyboard
KillMode=process
Restart=on-failure
RestartSec=5
Environment=DISPLAY=:0
Environment=XDG_CONFIG_HOME=%h/.config

[Install]
WantedBy=graphical-session.target
